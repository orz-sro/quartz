<mxGraphModel dx="535" dy="695" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" background="#1A1A1A" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="中国近现代史纲要 · 完整导览图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;fontSize=24;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="750" y="10" width="450" height="55" as="geometry"/></mxCell><mxCell id="P1" value="旧民主主义革命 1840-1919" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#FFFFFF;strokeColor=none;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="80" width="400" height="45" as="geometry"/></mxCell><mxCell id="E1" value="&lt;b&gt;第一次鸦片战争&lt;/b&gt;&#10;1840-1842·广东" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="145" width="200" height="55" as="geometry"/></mxCell><mxCell id="E1d" value="《南京条约》：割香港岛、赔款2100万银元、五口通商&#10;《虎门条约》《望厦条约》《黄埔条约》&#10;中国开始沦为半殖半封社会，近代史开端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="205" width="200" height="60" as="geometry"/></mxCell><mxCell id="E2" value="&lt;b&gt;太平天国运动&lt;/b&gt;&#10;1851-1864·广西金田" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA726;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="280" width="200" height="55" as="geometry"/></mxCell><mxCell id="E2d" value="《天朝田亩制度》：最能体现社会理想，绝对平均主义&#10;《资政新篇》：中国近代第一个发展资本主义方案&#10;失败原因：农民阶级局限性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="E3" value="&lt;b&gt;第二次鸦片战争&lt;/b&gt;&#10;1856-1860" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="250" y="145" width="200" height="55" as="geometry"/></mxCell><mxCell id="E3d" value="《天津条约》《北京条约》&#10;英法联军火烧圆明园&#10;中国半殖半封程度进一步加深" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="250" y="205" width="200" height="50" as="geometry"/></mxCell><mxCell id="E4" value="&lt;b&gt;洋务运动&lt;/b&gt;&#10;1861-1895" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA726;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="250" y="280" width="200" height="55" as="geometry"/></mxCell><mxCell id="E4d" value="口号：自强（军事工业）、求富（民用工业）&#10;失败标志：甲午战争北洋舰队全军覆没&#10;性质：地主阶级自救运动，未触动封建制度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="250" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="E5" value="&lt;b&gt;甲午中日战争&lt;/b&gt;&#10;1894-1895·黄海" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="470" y="145" width="200" height="55" as="geometry"/></mxCell><mxCell id="E5d" value="《马关条约》：割让台湾、赔款2亿两白银&#10;大大加深中国半殖半封程度&#10;刺激列强瓜分中国野心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="470" y="205" width="200" height="50" as="geometry"/></mxCell><mxCell id="E6" value="&lt;b&gt;戊戌维新运动&lt;/b&gt;&#10;1898·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="470" y="280" width="200" height="55" as="geometry"/></mxCell><mxCell id="E6d" value="百日维新，历时103天&#10;性质：资产阶级改良运动&#10;意义：思想启蒙作用，促进思想解放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="470" y="340" width="200" height="50" as="geometry"/></mxCell><mxCell id="E7" value="&lt;b&gt;义和团运动&lt;/b&gt;&#10;1900·华北" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA726;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="690" y="145" width="200" height="55" as="geometry"/></mxCell><mxCell id="E7d" value="《辛丑条约》：赔款4.5亿两白银，本息合计9.8亿两&#10;中国完全沦为半殖半封社会&#10;清政府成为&quot;洋人的朝廷&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="690" y="205" width="200" height="60" as="geometry"/></mxCell><mxCell id="E8" value="&lt;b&gt;辛亥革命&lt;/b&gt;&#10;1911·武昌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="690" y="280" width="200" height="55" as="geometry"/></mxCell><mxCell id="E8d" value="推翻清王朝，结束封建帝制&#10;建立中华民国（亚洲第一个共和国）&#10;三民主义：民族、民权、民生&#10;局限：未完成反帝反封建任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="690" y="340" width="200" height="65" as="geometry"/></mxCell><mxCell id="E9" value="&lt;b&gt;新文化运动&lt;/b&gt;&#10;1915·上海" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="910" y="145" width="200" height="55" as="geometry"/></mxCell><mxCell id="E9d" value="口号：民主（德先生）、科学（赛先生）&#10;《新青年》杂志、北京大学&#10;后期传播马克思主义，为中共成立做准备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="910" y="205" width="200" height="55" as="geometry"/></mxCell><mxCell id="P2" value="新民主主义革命 1919-1949" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="430" width="400" height="45" as="geometry"/></mxCell><mxCell id="E10" value="&lt;b&gt;五四运动&lt;/b&gt;&#10;1919·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E10d" value="新民主主义革命开端&#10;工人阶级登上历史舞台&#10;促进马克思主义在中国传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E11" value="&lt;b&gt;中共一大&lt;/b&gt;&#10;1921·上海→嘉兴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="230" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E11d" value="中国共产党诞生&#10;中国革命面貌焕然一新&#10;确定党的名称、纲领、中心工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="230" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E12" value="&lt;b&gt;中共二大&lt;/b&gt;&#10;1922·上海" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="430" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E12d" value="第一次提出彻底的反帝反封建民主革命纲领&#10;最高纲领：实现共产主义&#10;最低纲领：打倒军阀、推翻帝国主义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="430" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E13" value="&lt;b&gt;国民革命&lt;/b&gt;&#10;1924-1927" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="630" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E13d" value="第一次国共合作&#10;北伐战争胜利进军&#10;四一二、七一五反革命政变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="630" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E14" value="&lt;b&gt;南昌起义&lt;/b&gt;&#10;1927·南昌" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="830" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E14d" value="创建人民军队的开端&#10;打响武装反抗国民党第一枪&#10;党指挥枪的开端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="830" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E15" value="&lt;b&gt;八七会议&lt;/b&gt;&#10;1927·汉口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1030" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E15d" value="总方针：土地革命、武装反抗&#10;毛泽东：枪杆子里面出政权&#10;纠正右倾机会主义错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1030" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E16" value="&lt;b&gt;秋收起义&lt;/b&gt;&#10;1927·湘赣边界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1230" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E16d" value="打出工农革命军旗帜&#10;受挫后转向农村&#10;建立井冈山革命根据地" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1230" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E17" value="&lt;b&gt;三湾改编&lt;/b&gt;&#10;1927·江西" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1430" y="495" width="180" height="50" as="geometry"/></mxCell><mxCell id="E17d" value="建设新型人民军队的开端&#10;支部建在连上&#10;确立党对军队的绝对领导" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1430" y="550" width="180" height="50" as="geometry"/></mxCell><mxCell id="E18" value="&lt;b&gt;井冈山会师&lt;/b&gt;&#10;1928·井冈山" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E18d" value="朱德、陈毅率领南昌起义余部&#10;与毛泽东领导的工农革命军会师&#10;成立中国工农红军第四军" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E19" value="&lt;b&gt;古田会议&lt;/b&gt;&#10;1929·福建古田" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="230" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E19d" value="思想建党、政治建军&#10;确立人民军队建设基本原则&#10;重申党对红军的绝对领导" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="230" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E20" value="&lt;b&gt;长征&lt;/b&gt;&#10;1934.10-1936.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA726;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="430" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E20d" value="二万五千里长征&#10;保存了革命基干力量&#10;传播了革命思想" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="430" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E21" value="&lt;b&gt;遵义会议&lt;/b&gt;&#10;1935·贵州遵义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="630" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E21d" value="生死攸关的转折点&#10;确立毛泽东在党中央的领导地位&#10;标志着党从幼稚走向成熟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="630" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E22" value="&lt;b&gt;瓦窑堡会议&lt;/b&gt;&#10;1935·陕北" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="830" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E22d" value="确定建立抗日民族统一战线方针&#10;批评&quot;左&quot;倾关门主义&#10;提出&quot;停止内战，一致抗日&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="830" y="675" width="180" height="55" as="geometry"/></mxCell><mxCell id="E23" value="&lt;b&gt;西安事变&lt;/b&gt;&#10;1936·西安" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1030" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E23d" value="时局转换的枢纽&#10;十年内战基本结束&#10;抗日民族统一战线初步形成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1030" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E24" value="&lt;b&gt;七七事变&lt;/b&gt;&#10;1937·北平" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1230" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E24d" value="全面抗战开始&#10;日本全面侵华战争爆发&#10;中华民族进入生死存亡关头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1230" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E25" value="&lt;b&gt;洛川会议&lt;/b&gt;&#10;1937·陕北" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1430" y="620" width="180" height="50" as="geometry"/></mxCell><mxCell id="E25d" value="制定全面抗战路线&#10;开辟敌后战场&#10;建立抗日根据地" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1430" y="675" width="180" height="50" as="geometry"/></mxCell><mxCell id="E26" value="&lt;b&gt;平型关大捷&lt;/b&gt;&#10;1937·山西" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E26d" value="全面抗战以来第一次大捷&#10;粉碎&quot;日军不可战胜&quot;神话&#10;八路军取得的胜利" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E27" value="&lt;b&gt;台儿庄战役&lt;/b&gt;&#10;1938·山东" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="230" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E27d" value="抗战以来国民党正面战场最大胜利&#10;打击日军嚣张气焰&#10;振奋全国军民抗战信心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="230" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E28" value="&lt;b&gt;百团大战&lt;/b&gt;&#10;1940·华北" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="430" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E28d" value="敌后战场规模最大战役&#10;彭德怀指挥&#10;振奋全国军民抗战信心" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="430" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E29" value="&lt;b&gt;延安整风运动&lt;/b&gt;&#10;1942·延安" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="630" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E29d" value="反对主观主义、宗派主义、党八股&#10;确立实事求是思想路线&#10;为抗战胜利奠定思想基础" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="630" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E30" value="&lt;b&gt;中共七大&lt;/b&gt;&#10;1945·延安" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="830" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E30d" value="确立毛泽东思想为党的指导思想&#10;总结历史经验&#10;为抗战胜利和新民主主义革命胜利奠定基础" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="830" y="805" width="180" height="55" as="geometry"/></mxCell><mxCell id="E31" value="&lt;b&gt;抗战胜利&lt;/b&gt;&#10;1945·8月15日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="1030" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E31d" value="日本宣布无条件投降&#10;近代以来第一次完全胜利&#10;提高中国国际地位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1030" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E32" value="&lt;b&gt;重庆谈判&lt;/b&gt;&#10;1945·重庆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1230" y="750" width="180" height="50" as="geometry"/></mxCell><mxCell id="E32d" value="签订《双十协定》&#10;和平建国&#10;揭露国民党假和平真内战阴谋" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1230" y="805" width="180" height="50" as="geometry"/></mxCell><mxCell id="E33" value="&lt;b&gt;三大战役&lt;/b&gt;&#10;1948-1949" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="880" width="180" height="50" as="geometry"/></mxCell><mxCell id="E33d" value="辽沈、淮海、平津战役&#10;基本消灭国民党军队主力&#10;解放东北全境、华北全境" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="935" width="180" height="50" as="geometry"/></mxCell><mxCell id="E34" value="&lt;b&gt;七届二中全会&lt;/b&gt;&#10;1949·西柏坡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="230" y="880" width="180" height="50" as="geometry"/></mxCell><mxCell id="E34d" value="工作重心由农村→城市&#10;提出&quot;两个务必&quot;&#10;为新中国的建立做准备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="230" y="935" width="180" height="50" as="geometry"/></mxCell><mxCell id="E35" value="&lt;b&gt;开国大典&lt;/b&gt;&#10;1949·10·1·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="430" y="880" width="200" height="50" as="geometry"/></mxCell><mxCell id="E35d" value="中华人民共和国成立&#10;中国人民站起来了&#10;新民主主义革命胜利&#10;半殖半封社会结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="430" y="935" width="200" height="60" as="geometry"/></mxCell><mxCell id="P3" value="社会主义革命和建设 1949-1978" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="1020" width="400" height="45" as="geometry"/></mxCell><mxCell id="E36" value="&lt;b&gt;土地改革&lt;/b&gt;&#10;1950-1952" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E36d" value="废除封建土地所有制&#10;农民获得土地&#10;巩固新生政权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="1140" width="180" height="50" as="geometry"/></mxCell><mxCell id="E37" value="&lt;b&gt;三大改造&lt;/b&gt;&#10;1953-1956" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="230" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E37d" value="农业、手工业、资本主义工商业改造&#10;社会主义制度确立&#10;进入社会主义初级阶段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="230" y="1140" width="180" height="50" as="geometry"/></mxCell><mxCell id="E38" value="&lt;b&gt;一五计划&lt;/b&gt;&#10;1953-1957" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="430" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E38d" value="集中力量发展重工业&#10;开始改变工业落后面貌&#10;为社会主义工业化奠定初步基础" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="430" y="1140" width="180" height="50" as="geometry"/></mxCell><mxCell id="E39" value="&lt;b&gt;中共八大&lt;/b&gt;&#10;1956·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="630" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E39d" value="正确分析国内主要矛盾&#10;主要矛盾：人民需要vs落后生产&#10;主要任务：集中力量发展生产力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="630" y="1140" width="180" height="50" as="geometry"/></mxCell><mxCell id="E40" value="&lt;b&gt;论十大关系&lt;/b&gt;&#10;1956·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AB47BC;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="830" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E40d" value="初步总结社会主义建设经验&#10;探索中国自己的建设道路&#10;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="830" y="1140" width="180" height="40" as="geometry"/></mxCell><mxCell id="E41" value="&lt;b&gt;文化大革命&lt;/b&gt;&#10;1966-1976" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;shadow=1;" parent="1" vertex="1"><mxGeometry x="1030" y="1085" width="180" height="50" as="geometry"/></mxCell><mxCell id="E41d" value="严重错误：阶级斗争扩大化&#10;给党、国家和人民带来严重灾难&#10;教训：必须加强民主法制建设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="1030" y="1140" width="180" height="50" as="geometry"/></mxCell><mxCell id="P4" value="改革开放 1978至今" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;fontColor=#FFFFFF;strokeColor=none;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="1220" width="400" height="45" as="geometry"/></mxCell><mxCell id="E42" value="&lt;b&gt;十一届三中全会&lt;/b&gt;&#10;1978·北京" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF5350;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="30" y="1285" width="200" height="50" as="geometry"/></mxCell><mxCell id="E42d" value="改革开放的伟大开端&#10;重新确立马克思主义思想路线&#10;工作重心转移到经济建设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="1340" width="200" height="50" as="geometry"/></mxCell><mxCell id="E43" value="&lt;b&gt;改革开放&lt;/b&gt;&#10;1978至今" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#66BB6A;fontColor=#FFFFFF;strokeColor=none;fontSize=12;fontStyle=1;shadow=1;" parent="1" vertex="1"><mxGeometry x="250" y="1285" width="200" height="50" as="geometry"/></mxCell><mxCell id="E43d" value="农村改革：家庭联产承包责任制&#10;城市改革：建立社会主义市场经济&#10;对外开放：经济特区→沿海开放城市" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#90A4AE;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="250" y="1340" width="200" height="50" as="geometry"/></mxCell><mxCell id="D0" value="重要文献" style="text;html=1;align=left;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="30" y="1420" width="100" height="25" as="geometry"/></mxCell><mxCell id="D1" value="《天朝田亩制度》&#10;1853·太平天国" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#546E7A;fontColor=#FFFFFF;strokeColor=none;fontSize=9;" parent="1" vertex="1"><mxGeometry x="30" y="1455" width="150" height="35" as="geometry"/></mxCell><mxCell id="D2" value="《资政新篇》&